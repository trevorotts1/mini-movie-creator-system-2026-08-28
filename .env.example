# Copy to .env (repo root) and fill in what you use.
# NAMES ONLY — never commit real values. .env* is gitignored except this file.

# MMCS engine providers ------------------------------------------------------

# Agnes AI — text/reasoning models (default director/writer/QC routing).
AGNES_API_KEY=

# Kie.ai — generative video/image jobs (clips, frames).
KIE_API_KEY=

# Fish Audio — speech/TTS voice lines.
FISH_API_KEY=

# GoHighLevel — client media storage destination (subaccount-scoped).
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=

# OpenRouter — optional multi-provider model fallback routing.
OPENROUTER_API_KEY=

# 9Router — local model router (URL + key for engine-side model calls).
NINEROUTER_URL=
NINEROUTER_KEY=

# Upstream (inherited Python tools) -------------------------------------------

# ElevenLabs — required for voice (tools/gen_voice.py); also powers
# sound-effect generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=

# Google Gemini — image generation (tools/gen_image.py), e.g. story frames.
GEMINI_API_KEY=

# fal.ai — optional, generative video clips (tools/gen_clip.py).
FAL_KEY=