{
  "name": "@mmcs/remotion-runtime",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p ../tsconfig.pkg.json"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.518",
    "@mmcs/core": "workspace:*",
    "@mmcs/database": "workspace:*",
    "@mmcs/capability-registry": "workspace:*",
    "@mmcs/scene-intelligence": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "type": "module"
}
