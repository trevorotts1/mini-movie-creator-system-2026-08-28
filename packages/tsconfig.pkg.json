{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@mmcs/core": ["./core/src/index.ts"],
      "@mmcs/core/*": ["./core/src/*"],
      "@mmcs/domain": ["./domain/src/index.ts"],
      "@mmcs/domain/*": ["./domain/src/*"],
      "@mmcs/database": ["./database/src/index.ts"],
      "@mmcs/database/*": ["./database/src/*"],
      "@mmcs/providers": ["./providers/src/index.ts"],
      "@mmcs/providers/*": ["./providers/src/*"],
      "@mmcs/capability-registry": ["./capability-registry/src/index.ts"],
      "@mmcs/capability-registry/*": ["./capability-registry/src/*"],
      "@mmcs/prompt-compilers": ["./prompt-compilers/src/index.ts"],
      "@mmcs/prompt-compilers/*": ["./prompt-compilers/src/*"],
      "@mmcs/scene-intelligence": ["./scene-intelligence/src/index.ts"],
      "@mmcs/scene-intelligence/*": ["./scene-intelligence/src/*"],
      "@mmcs/character-library": ["./character-library/src/index.ts"],
      "@mmcs/character-library/*": ["./character-library/src/*"],
      "@mmcs/media-storage": ["./media-storage/src/index.ts"],
      "@mmcs/media-storage/*": ["./media-storage/src/*"],
      "@mmcs/qc": ["./qc/src/index.ts"],
      "@mmcs/qc/*": ["./qc/src/*"],
      "@mmcs/cost-engine": ["./cost-engine/src/index.ts"],
      "@mmcs/cost-engine/*": ["./cost-engine/src/*"],
      "@mmcs/remotion-runtime": ["./remotion-runtime/src/index.ts"],
      "@mmcs/remotion-runtime/*": ["./remotion-runtime/src/*"]
    }
  },
  "include": ["*/src/**/*.ts", "*/src/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "*/node_modules", "*/dist"]
}
