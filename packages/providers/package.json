{
  "name": "@mmcs/providers",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p ../tsconfig.pkg.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "type": "module",
  "dependencies": {
    "@mmcs/capability-registry": "workspace:*",
    "@mmcs/core": "workspace:*",
    "@mmcs/database": "workspace:*",
    "@mmcs/media-storage": "workspace:*",
    "@mmcs/qc": "workspace:*",
    "@mmcs/cost-engine": "workspace:*"
  }
}
