# secrets
.env

# dependencies / build output
node_modules/
remotion/out/
__pycache__/
*.pyc
venv/

# heavy regenerable per-short artifacts:
# voice/ = cached ElevenLabs TTS lines, output/ = rendered videos.
# Both are rebuilt by the pipeline; finals are linked from the README instead.
shorts/*/voice/
shorts/*/output/
ai-shorts/*/voice/
ai-shorts/*/output/
vox-shorts/*/voice/
vox-shorts/*/output/

# ai-shorts working copies of generated clips — the canonical (committed) copies
# live in media/projects/<name>/ where the composition reads them via staticFile()
ai-shorts/*/shots/*.mp4
ai-shorts/*/bakeoff/*.mp4

# local editor config
.vscode/

# --- MMCS monorepo additions (scaffold 2026-08-28) ---
dist/
logs/
worktrees/
state/locks/
coverage/
*.tsbuildinfo

# env files — keep .env.example tracked
.env
.env.*
!.env.example
*.bak-batch*

# engine runtime state (durable stores; per-checkout, never committed)
state/

# composite emit output + per-pkg dist links
packages/dist/
packages/*/dist
