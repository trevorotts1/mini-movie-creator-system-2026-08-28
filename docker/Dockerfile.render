# MMCS Linux render environment (SKR-033)
#
# The repo rendered only on macOS: `@remotion/compositor-darwin-arm64` was the only
# compositor installed and headless Chrome was cached for mac-arm64 only. Nothing defined a
# Linux environment, so "works in a container" was an untested claim. This image is that
# environment, and scripts/release/linux-render-check.sh proves a real render inside it
# rather than assuming one.
#
# Each choice below is tied to a specific way this fails, checked against the installed
# Remotion 4.0.518 rather than assumed:
#
#   * `--include=optional` on install. Remotion ships its per-platform binary
#     (`@remotion/renderer` -> `@remotion/compositor-<platform>`) as OPTIONAL dependencies.
#     An install that skips optional deps produces a tree with NO compositor at all, which
#     fails at render time instead of install time, with a confusing error.
#   * Chrome's shared libraries are installed explicitly. `chrome-headless-shell` is
#     dynamically linked; on a slim base it aborts with a missing-library error that reads
#     like a Remotion bug.
#   * `ffmpeg` is installed because the release gate ffprobe-validates every render output.
#
# NOT done here, deliberately:
#   * No `--no-sandbox` plumbing. `@remotion/renderer/dist/open-browser.js` already passes
#     `--no-sandbox` and `--disable-setuid-sandbox` unconditionally (lines 145-146). A seam
#     for it would be dead configuration - an earlier draft of this file had one, and it was
#     wrong.
#   * No `chromiumOptions` override. The only Linux-relevant knob is
#     `enableMultiProcessOnLinux` (Remotion otherwise forces `--single-process` on Linux),
#     which is a stability lever to pull only if the render check actually shows a problem.

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# 1. System libraries Chrome and ffmpeg need.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      ffmpeg \
      fonts-dejavu-core \
      fonts-liberation \
      libasound2 \
      libatk-bridge2.0-0 \
      libatk1.0-0 \
      libcairo2 \
      libcups2 \
      libdbus-1-3 \
      libdrm2 \
      libexpat1 \
      libgbm1 \
      libglib2.0-0 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libx11-6 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
      tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. The render workspace's dependencies, installed FOR LINUX. This is the step that pulls
#    @remotion/compositor-linux-*-gnu instead of the darwin binary.
COPY remotion/package.json remotion/package-lock.json ./remotion/
RUN npm --prefix remotion ci --include=optional --no-audit --no-fund

# 3. Warm the headless-Chrome download at build time, so the first render does not pay for it
#    and a run with no egress still works.
RUN node -e "const {ensureBrowser}=require('/app/remotion/node_modules/@remotion/renderer'); ensureBrowser().then(()=>console.log('chrome ready')).catch(e=>{console.error(e);process.exit(1)})"

# 4. The rest of the tree: compositions, engine, and the release scripts the check drives.
#    .dockerignore keeps the macOS node_modules, worktrees and .git out of the context.
COPY . .

# 5. Assert the Linux compositor is present. Without this the image builds happily and fails
#    at render time; here it fails at build time, naming the missing binary.
COPY docker/verify-compositor.mjs /tmp/verify-compositor.mjs
RUN node /tmp/verify-compositor.mjs

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "scripts/release/linux-render-check.sh"]
