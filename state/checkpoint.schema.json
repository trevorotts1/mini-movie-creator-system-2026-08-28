{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmcs.local/state/checkpoint.schema.json",
  "title": "MMCS machine-readable checkpoint (state/checkpoint.json)",
  "description": "Runbook §5 field set (authoritative minimum) plus runbook PART II §4 extensions. Written atomically by @mmcs/core recovery CheckpointService; never hand-edited.",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "repoRoot",
    "origin",
    "upstream",
    "integrationBranch",
    "lastCheckpointAt",
    "currentWave",
    "buildComplete",
    "activeWorkflowIds",
    "readyTaskIds",
    "activeTaskIds",
    "qcTaskIds",
    "blockedTaskIds",
    "mergeQueueTaskIds",
    "activeAgentIds",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "repoRoot": { "type": "string", "minLength": 1 },
    "origin": { "type": "string" },
    "upstream": { "type": "string" },
    "integrationBranch": { "type": "string", "minLength": 1, "default": "integration" },
    "lastCheckpointAt": { "type": "string", "format": "date-time" },
    "lastMergeAt": { "type": ["string", "null"], "format": "date-time" },
    "lastWatchdogAt": { "type": ["string", "null"], "format": "date-time" },
    "currentWave": { "type": "integer", "minimum": 1, "default": 1 },
    "buildComplete": { "type": "boolean", "default": false },
    "activeWorkflowIds": { "type": "array", "items": { "type": "string" } },
    "readyTaskIds": { "type": "array", "items": { "type": "string" } },
    "activeTaskIds": { "type": "array", "items": { "type": "string" } },
    "qcTaskIds": { "type": "array", "items": { "type": "string" } },
    "blockedTaskIds": { "type": "array", "items": { "type": "string" } },
    "mergeQueueTaskIds": { "type": "array", "items": { "type": "string" } },
    "activeAgentIds": { "type": "array", "items": { "type": "string" } },
    "lastKnownGoodCommit": { "type": ["string", "null"] },
    "currentMainSha": { "type": ["string", "null"] },
    "currentIntegrationSha": { "type": ["string", "null"] },
    "lastFullRegressionAt": { "type": ["string", "null"], "format": "date-time" },
    "nextActions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}