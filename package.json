{
  "name": "mmcs-monorepo",
  "version": "1.0.10",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "integrations/*"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npx --no-install tsc -p packages/tsconfig.pkg.json && bash scripts/link-dist-deps.sh && pnpm --filter @mmcs/cli build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
