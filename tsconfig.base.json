{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@mmcs/core": ["./packages/core/src/index.ts"],
      "@mmcs/core/*": ["./packages/core/src/*"],
      "@mmcs/domain": ["./packages/domain/src/index.ts"],
      "@mmcs/domain/*": ["./packages/domain/src/*"],
      "@mmcs/database": ["./packages/database/src/index.ts"],
      "@mmcs/database/*": ["./packages/database/src/*"],
      "@mmcs/providers": ["./packages/providers/src/index.ts"],
      "@mmcs/providers/*": ["./packages/providers/src/*"],
      "@mmcs/capability-registry": ["./packages/capability-registry/src/index.ts"],
      "@mmcs/capability-registry/*": ["./packages/capability-registry/src/*"],
      "@mmcs/prompt-compilers": ["./packages/prompt-compilers/src/index.ts"],
      "@mmcs/prompt-compilers/*": ["./packages/prompt-compilers/src/*"],
      "@mmcs/scene-intelligence": ["./packages/scene-intelligence/src/index.ts"],
      "@mmcs/scene-intelligence/*": ["./packages/scene-intelligence/src/*"],
      "@mmcs/character-library": ["./packages/character-library/src/index.ts"],
      "@mmcs/character-library/*": ["./packages/character-library/src/*"],
      "@mmcs/media-storage": ["./packages/media-storage/src/index.ts"],
      "@mmcs/media-storage/*": ["./packages/media-storage/src/*"],
      "@mmcs/qc": ["./packages/qc/src/index.ts"],
      "@mmcs/qc/*": ["./packages/qc/src/*"],
      "@mmcs/cost-engine": ["./packages/cost-engine/src/index.ts"],
      "@mmcs/cost-engine/*": ["./packages/cost-engine/src/*"],
      "@mmcs/remotion-runtime": ["./packages/remotion-runtime/src/index.ts"],
      "@mmcs/remotion-runtime/*": ["./packages/remotion-runtime/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "remotion"]
}